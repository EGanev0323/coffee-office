# Копирай този файл като .env и попълни стойностите.

# Порт, на който приложението ще е достъпно на сървъра (http://сървър:APP_PORT)
APP_PORT=8080

# База данни
POSTGRES_DB=coffee
POSTGRES_USER=coffee
POSTGRES_PASSWORD=смени-ме-със-силна-парола

# Секрет за подписване на токените – поне 32 символа.
# Генерирай с: openssl rand -base64 48
JWT_SECRET=
JWT_TTL_HOURS=12

# Първи администратор (създава се само при първо стартиране, ако няма активен админ)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=смени-ме
ADMIN_DISPLAY_NAME=Администратор

# Часова зона за границите на месеца в отчета
APP_TIMEZONE=Europe/Sofia
